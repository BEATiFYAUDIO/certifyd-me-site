# Certifyd internal admin dashboard production env
NODE_ENV=production
HOST=127.0.0.1
PORT=8000
CONTENT_DASHBOARD_ENABLED=true
CONTENT_DASHBOARD_ENV=production
CONTENT_DASHBOARD_AUTH_MODE=cloudflare-access
ALLOW_TEMPORARY_TUNNEL_TESTING=false
CONTENT_DASHBOARD_PUBLIC_URL=https://admin.certifyd.me
CONTENT_DASHBOARD_SESSION_SECRET=replace-with-32-byte-random-secret
CONTENT_AGENT_ROOT=/srv/certifyd/content-agent
CONTENT_AGENT_OUTPUT_DIR=/srv/certifyd/content-agent/engine/outputs
CONTENT_DASHBOARD_DB_PATH=/srv/certifyd/content-dashboard/content-dashboard.sqlite

# Cloudflare Access verification. This is an app-layer origin-bypass guard.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace-with-cloudflare-access-audience-tag

# First-run user bootstrap only. After the SQLite users table exists, edit users in the database.
CONTENT_DASHBOARD_FOUNDER_EMAILS=darryl@example.com
CONTENT_DASHBOARD_ALLOWED_ROLES="viewer:vassal@example.com;editor:editor@example.com"

# Local AI provider. Ollama must run locally; do not expose port 11434 publicly.
CONTENT_MODEL_PROVIDER=ollama
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTENT_MODEL=qwen3:8b
OLLAMA_REQUEST_TIMEOUT_MS=180000
OLLAMA_MAX_OUTPUT_TOKENS=5000
OLLAMA_TEMPERATURE=0.35
OLLAMA_CONTEXT_LIMIT=24000
OLLAMA_THINK=false
OLLAMA_MAX_CONCURRENT_GENERATIONS=1
CONTENT_RESEARCH_PROVIDER=fixture

# Optional GitHub App draft-PR publishing. Disabled until all fields are configured.
CONTENT_DASHBOARD_GITHUB_PUBLISHING_ENABLED=false
CONTENT_DASHBOARD_GITHUB_OWNER=your-github-org-or-user
CONTENT_DASHBOARD_GITHUB_REPO=certifyd-me-site
CONTENT_DASHBOARD_GITHUB_BASE_BRANCH=main
CONTENT_DASHBOARD_GITHUB_BRANCH_PREFIX=content-dashboard
# direct writes to the base branch; draft-pr creates review branches and PRs.
CONTENT_DASHBOARD_GITHUB_PUBLISH_MODE=direct
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# Local/testing fallback for draft PR publishing through the same publisher abstraction.
# Prefer a GitHub App for production.
CONTENT_DASHBOARD_GITHUB_TOKEN=

# Optional direct-publish mirror. When enabled, publish/republish writes the
# generated blog routes/feed/sitemap/images to the preview site too. The default
# excluded path keeps the Vassal homepage from being overwritten by production.
CONTENT_DASHBOARD_GITHUB_MIRROR_ENABLED=true
CONTENT_DASHBOARD_GITHUB_MIRROR_OWNER=BEATiFYAUDIO
CONTENT_DASHBOARD_GITHUB_MIRROR_REPO=certifyd-me-site-preview
CONTENT_DASHBOARD_GITHUB_MIRROR_BASE_BRANCH=main
CONTENT_DASHBOARD_GITHUB_MIRROR_PUBLIC_URL=https://vassal.certifyd.me
CONTENT_DASHBOARD_GITHUB_MIRROR_EXCLUDE_PATHS=index.html

# Optional automatic cover image search. Uses Pexels API, downloads a selected image
# into /images/blog, and stores photographer/source credit with the article.
CONTENT_DASHBOARD_COVER_IMAGE_PROVIDER=pexels
CONTENT_DASHBOARD_PEXELS_API_KEY=
CONTENT_DASHBOARD_PEXELS_LOCALE=en-US

# Technical SEO verification and indexing.
# Google Search Console can verify through DNS, this meta token, or a static
# HTML verification file generated at build time.
GOOGLE_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION_FILE=
GOOGLE_SITE_VERIFICATION_FILE_CONTENT=

# IndexNow submits canonical article URLs to Bing/participating engines after
# publish, republish or unpublish. The key file is generated by npm run build.
CONTENT_DASHBOARD_INDEXNOW_ENABLED=false
CONTENT_DASHBOARD_INDEXNOW_KEY=
CONTENT_DASHBOARD_INDEXNOW_HOST=certifyd.me
CONTENT_DASHBOARD_INDEXNOW_PUBLIC_URL=https://certifyd.me
CONTENT_DASHBOARD_INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
CONTENT_DASHBOARD_COVER_IMAGE_TIMEOUT_MS=12000

# Distribution destination credentials. These are read server-side only.
# Certifyd Blog uses the GitHub publishing configuration above and remains canonical.
CONTENT_DISTRIBUTION_DEVTO_API_KEY=
CONTENT_DISTRIBUTION_BLOGGER_BLOG_ID=
CONTENT_DISTRIBUTION_BLOGGER_ACCESS_TOKEN=
CONTENT_DISTRIBUTION_WORDPRESS_API_URL=
CONTENT_DISTRIBUTION_WORDPRESS_TOKEN=
CONTENT_DISTRIBUTION_GHOST_ADMIN_API_URL=
CONTENT_DISTRIBUTION_GHOST_ADMIN_TOKEN=
CONTENT_DISTRIBUTION_HASHNODE_TOKEN=
CONTENT_DISTRIBUTION_HASHNODE_PUBLICATION_ID=
